<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Factions __________-->

    <!-- Great Khans -->

    <FactionDef ParentName="FactionBase">
        <defName>FCP_Faction_GreatKhans</defName>
        <label>Great Khans</label>
        <description>The Great Khans are a tribal raider society descended from the survivors of Vault 15, who spilled out into the wasteland and forged themselves into one of the most feared raider tribes in New California. Nearly exterminated by the Enclave, the shattered remnants of the tribe regrouped and made the long trek east, reforming and rebuilding in the Mojave. Once one of the most powerful raider tribes in the wasteland, they have endured numerous conflicts with the NCR and other factions that have decimated their numbers. Despite their setbacks, the Khans remain proud and fiercely independent, refusing to bow to anyone. They have become experts at producing chems, which they trade for weapons and supplies. The Khans value strength, loyalty to the tribe, and the freedom to live as they choose - free from the laws and taxes of "civilized" societies. They are a nomadic people, living in yurts and tents that can be quickly packed up when it's time to move on.</description>
        <colorSpectrum>
            <li>(1, 1, 1)</li>
        </colorSpectrum>
        <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
        <pawnSingular>Khan</pawnSingular>
        <pawnsPlural>Khans</pawnsPlural>
        <categoryTag>Outlander</categoryTag>
        <settlementGenerationWeight>0.15</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <canSiege>true</canSiege>
        <canStageAttacks>true</canStageAttacks>
        <leaderTitle>Papa Khan</leaderTitle>
        <fixedLeaderKinds>
            <li>FCP_Unique_Pawnkind_Papa_Khan</li>
        </fixedLeaderKinds>
        <factionIconPath>World_Icon/Great_Khan_Icon/FCP_GreatKhans_World_Icon</factionIconPath>
        <techLevel>Industrial</techLevel>
        <fixedName>Great Khans</fixedName>
        <settlementNameMaker>FCP_Namer_Settlement_Great_Khan</settlementNameMaker>
        <allowedCultures>
            <li>FCP_Culture_Khan</li>
        </allowedCultures>

        <!--__________ Royalty __________-->

        <royalTitleTags>
            <li>FCP_Title_GreatKhans</li>
        </royalTitleTags>
        <royalFavorLabel>respect</royalFavorLabel>
        <royalTitleInheritanceWorkerClass>RoyalTitleInheritanceWorker</royalTitleInheritanceWorkerClass>
        <royalTitleInheritanceRelations>
            <li>Child</li>
            <li>Spouse</li>
        </royalTitleInheritanceRelations>

        <!--__________ Ideology __________-->

        <fixedIdeo>true</fixedIdeo>
        <ideoName>Khan Way</ideoName>
        <ideoDescription>The Great Khans live by a code of strength, independence, and loyalty to the tribe. They reject the rules and restrictions of "civilized" society, preferring to take what they need and live free. The strong survive, the weak perish, and the tribe endures above all else.</ideoDescription>
        <styles>
            <li>FCP_Style_Khan</li>
        </styles>
        <forcedMemes>
            <!-- Structure -->
            <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
            <!-- Memes -->
            <li MayRequire="Ludeon.RimWorld.Ideology">FCP_Meme_Khan_Freedom</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">FCP_Meme_Khan_Chemists</li>
        </forcedMemes>
        <requiredPreceptsOnly>true</requiredPreceptsOnly>
        <disallowedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Loyalist</li>
        </disallowedMemes>

        <!--__________ Biotech __________-->

        <xenotypeSet>
            <xenotypeChances>
                <Neanderthal MayRequire="Ludeon.RimWorld.Biotech">0</Neanderthal>
                <Hussar MayRequire="Ludeon.RimWorld.Biotech">0</Hussar>
                <Pigskin MayRequire="Ludeon.RimWorld.Biotech">0</Pigskin>
                <Yttakin MayRequire="Ludeon.RimWorld.Biotech">0</Yttakin>
                <Genie MayRequire="Ludeon.RimWorld.Biotech">0</Genie>
                <Dirtmole MayRequire="Ludeon.RimWorld.Biotech">0</Dirtmole>
                <Highmate MayRequire="Ludeon.RimWorld.Biotech">0</Highmate>
            </xenotypeChances>
        </xenotypeSet>

        <!--__________ Backstories __________-->

        <backstoryFilters>
            <li>
                <categoriesChildhood>
                    <li>FCP_Backstory_Khan_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>FCP_Backstory_Khan</li>
                    <li>FCP_Backstory_Wastelanders</li>
                </categoriesAdulthood>
                <commonality>1</commonality>
            </li>
        </backstoryFilters>

        <!--__________ Kinds __________-->

        <!-- Caravan Trader Kinds -->

        <caravanTraderKinds>
            <li>FCP_Caravan_Khan_Chem_Dealer</li>
            <li>Caravan_Outlander_CombatSupplier</li>
            <li>Caravan_Outlander_PirateMerchant</li>
        </caravanTraderKinds>

        <!-- Vistor Trader Kinds -->

        <visitorTraderKinds>
            <li>FCP_Caravan_Khan_Chem_Dealer</li>
            <li>Caravan_Outlander_CombatSupplier</li>
            <li>Caravan_Outlander_PirateMerchant</li>
        </visitorTraderKinds>

        <!-- Base Trader Kinds -->

        <baseTraderKinds>
            <li>FCP_Base_Khan_Chem_Dealer</li>
            <li>Base_Outlander_Standard</li>
        </baseTraderKinds>

        <!-- Trader Kind Arrival Options -->

        <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
        <raidLootMaker>FCP_KhanRaidLootMaker</raidLootMaker>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0,35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>

        <!--__________ Group Makers __________-->

        <pawnGroupMakers>

            <!-- Khan Raiding Party -->

            <li Class="FCP.Core.GroupMakerWithCustomChar">
                <!-- Hardline warriors -->
                <kindDef>Combat</kindDef>
                <options>
                    <FCP_Pawnkind_Khan_Warrior>10</FCP_Pawnkind_Khan_Warrior>
                    <FCP_Pawnkind_Khan_Veteran>5</FCP_Pawnkind_Khan_Veteran>
                    <FCP_Pawnkind_Khan_Chem_Thrower>3</FCP_Pawnkind_Khan_Chem_Thrower>
                    <FCP_Pawnkind_Khan_Enforcer>2</FCP_Pawnkind_Khan_Enforcer>
                </options>
                <characterDefs>
                    <li>FCP_Character_Great_Khan_Melissa</li>
                    <li>FCP_Character_Great_Khan_Oscar</li>
                    <li>FCP_Character_Great_Khan_Jessup</li>
                    <li>FCP_Character_Great_Khan_Anders</li>
                </characterDefs>
                <characterChance>0.25</characterChance>
            </li>

            <!-- Khan Peaceful Visitors -->

            <li Class="FCP.Core.GroupMakerWithCustomChar">
                <!-- Jerry the Punk -->
                <kindDef>Peaceful</kindDef>
                <options>
                    <FCP_Pawnkind_Khan_Warrior>8</FCP_Pawnkind_Khan_Warrior>
                    <FCP_Pawnkind_Khan_Chem_Maker>5</FCP_Pawnkind_Khan_Chem_Maker>
                    <FCP_Pawnkind_Khan_Veteran>3</FCP_Pawnkind_Khan_Veteran>
                    <FCP_Pawnkind_Khan_Enforcer>1</FCP_Pawnkind_Khan_Enforcer>
                </options>
                <characterDefs>
                    <li>FCP_Character_Great_Khan_Jerry</li>
                </characterDefs>
                <characterChance>0.15</characterChance>
            </li>

            <!-- Khan Traders -->

            <li Class="FCP.Core.GroupMakerWithTraderKind">
                <kindDef>Trader</kindDef>
                <traderKinds>
                    <li>FCP_Caravan_Khan_Chem_Dealer</li>
                </traderKinds>
                <traders>
                    <FCP_Pawnkind_Khan_Chem_Dealer>1</FCP_Pawnkind_Khan_Chem_Dealer>
                </traders>
                <carriers>
                    <Muffalo>4</Muffalo>
                    <Dromedary>3</Dromedary>
                </carriers>
                <guards>
                    <FCP_Pawnkind_Khan_Warrior>8</FCP_Pawnkind_Khan_Warrior>
                    <FCP_Pawnkind_Khan_Veteran>3</FCP_Pawnkind_Khan_Veteran>
                    <FCP_Pawnkind_Khan_Enforcer>1</FCP_Pawnkind_Khan_Enforcer>
                </guards>
                <characterDefs>
                    <li>FCP_Character_Great_Khan_Melissa</li>
                </characterDefs>
                <characterTraderKinds>
                    <li>
                        <key>FCP_Character_Great_Khan_Melissa</key>
                        <value>FCP_Caravan_Khan_Chem_Dealer</value>
                    </li>
                </characterTraderKinds>
                <characterChance>0.3</characterChance>
            </li>

            <!-- Khan Settlement -->

            <li Class="FCP.Core.GroupMakerWithCustomChar">
                <!-- The home camp -->
                <kindDef>Settlement</kindDef>
                <options>
                    <FCP_Pawnkind_Khan_Civilian>15</FCP_Pawnkind_Khan_Civilian>
                    <FCP_Pawnkind_Khan_Warrior>10</FCP_Pawnkind_Khan_Warrior>
                    <FCP_Pawnkind_Khan_Chem_Maker>5</FCP_Pawnkind_Khan_Chem_Maker>
                    <FCP_Pawnkind_Khan_Veteran>3</FCP_Pawnkind_Khan_Veteran>
                    <FCP_Pawnkind_Khan_Enforcer>2</FCP_Pawnkind_Khan_Enforcer>
                    <FCP_Pawnkind_Khan_Advisor>1</FCP_Pawnkind_Khan_Advisor>
                </options>
                <characterDefs>
                    <li>FCP_Character_Great_Khan_Regis</li>
                    <li>FCP_Character_Great_Khan_Jack</li>
                    <li>FCP_Character_Great_Khan_Diane</li>
                    <li>FCP_Character_Great_Khan_Karl</li>
                    <li>FCP_Character_Great_Khan_McMurphy</li>
                </characterDefs>
                <characterChance>0.30</characterChance>
            </li>
        </pawnGroupMakers>
        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
		<modExtensions>
            <!-- Make them hostile to the NCR -->
            <li Class="FCP.Factions.FactionExtension_PermanentlyHostileTo">
                <hostileFactionDefs>
                    <li MayRequire="Rick.FCP.NCR">FCP_Faction_NCR</li>
                </hostileFactionDefs>
            </li>
            <!-- Make them unable to use drop pods -->
            <li Class="FCP.Factions.FactionExtension_BannedArrivalModes">
                <arrivalModes>
                    <li>EdgeDrop</li>
                    <li>EdgeDropGroups</li>
                    <li>CenterDrop</li>
                    <li>RandomDrop</li>
                </arrivalModes>
            </li>
            <!-- Ideology stuff -->
            <li Class="FCP.Factions.FactionExtension_FixedIdeo">
                <ideoIconDef>FCP_Icon_Khan_Freedom</ideoIconDef>
                <ideoColorDef>LightGrey</ideoColorDef>
                <memberName>Khan</memberName>
                <adjective>Khan</adjective>
                <roleOverrides>
                    <li>
                        <preceptDef>IdeoRole_Leader</preceptDef>
                        <newName>Great Khan</newName>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_Moralist</preceptDef>
                        <newName>Khan Storyteller</newName>
                        <disableApparelRequirements>true</disableApparelRequirements>
                        <!--<apparelRequirementsOverride></apparelRequirementsOverride>-->
                    </li>
                    <li>
                        <preceptDef>FCP_IdeoRole_Khan_Enforcer</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                </roleOverrides>
            </li>
            <!-- Clusters and biome configuration -->
            <li Class="FCP.Factions.FactionExtension_SettlementControl">
                <maxSettlements>4</maxSettlements>
                <allowedBiomes>
                    <li MayRequire="FIP.Arktos">Arktos_Mesa</li>
                    <li MayRequire="FIP.Arktos">Arktos_Canyon</li>
                    <li MayRequire="FIP.Arktos">Arktos_Mojave</li>
                    <li MayRequire="FIP.Arktos">Arktos_Wasteland</li>
                    <li>AridShrubland</li>
                    <li>Desert</li>
                    <li>ExtremeDesert</li>
                </allowedBiomes>
                <clustered>true</clustered>
                <clusterRadius>30</clusterRadius>
                <namedSettlements>
                    <!-- Red Rock Canyon -->
                    <li>
                        <name>Red Rock Canyon</name>
                        <mapGenerator>FCP_MapGen_Canyon</mapGenerator>
                        <forcedMapSize>(300, 1, 300)</forcedMapSize>
                        <preferredHilliness>
                            <li>Mountainous</li>
                        </preferredHilliness>
                        <allowedBiomes>
                            <li>Desert</li>
                            <li>ExtremeDesert</li>
                        </allowedBiomes>
                        <guaranteedCharacters>
                            <li>FCP_Character_Great_Khan_Papa_Khan</li>
                            <li>FCP_Character_Great_Khan_Jack</li>
                            <li>FCP_Character_Great_Khan_Diane</li>
                        </guaranteedCharacters>
                        <traders>
                            <li>
                                <traderName>Great Khan Armory</traderName>
                                <traderKind>FCP_Trader_RedRockCanyon_GreatKhanArmory</traderKind>
                            </li>
                            <li>
                                <traderName>Red Rock Drug Lab</traderName>
                                <traderKind>FCP_Trader_RedRockCanyon_RedRockDrugLab</traderKind>
                            </li>
                        </traders>
                    </li>
                    <!-- Vault 15 -->
                    <li>
                        <name>Vault 15</name>
                        <traders>
                            <li>
                                <traderName>Vault 15 Salvage</traderName>
                                <traderKind>FCP_Trader_Vault15_Salvage</traderKind>
                            </li>
                        </traders>
                    </li>
                    <!-- Khan Base -->
                    <li>
                        <name>Khan Base</name>
                        <guaranteedCharacters>
                            <li>FCP_Character_Great_Khan_McMurphy</li>
                        </guaranteedCharacters>
                        <traders>
                            <li>
                                <traderName>Garl's Camp</traderName>
                                <traderKind>FCP_Trader_KhanBase_GarlsCamp</traderKind>
                            </li>
                        </traders>
                    </li>
                    <!-- Bitter Springs -->
                    <li>
                        <name>Bitter Springs</name>
                        <traders>
                            <li>
                                <traderName>Bitter Springs Muster</traderName>
                                <traderKind>FCP_Trader_BitterSprings_Muster</traderKind>
                            </li>
                        </traders>
                    </li>
                </namedSettlements>
            </li>
            <!-- Rank track -->
            <li Class="FCP.Ranks.FactionExtension_RankTracks">
                <rankTracks>
                    <li>FCP_RankTrack_GreatKhans</li>
                </rankTracks>
            </li>
            <!-- Enlistment stuff -->
            <li Class="FCP.Enlist.FactionEnlistOptions">
                <enlistOptionsDefs>
                    <li>FCP_Enlistment_GreatKhans</li>
                </enlistOptionsDefs>
                <ignoreAutoAssignedDefs>true</ignoreAutoAssignedDefs>
            </li>
                </modExtensions>
    </FactionDef>

    <ThingSetMakerDef>
        <defName>FCP_KhanRaidLootMaker</defName>
        <root Class="ThingSetMaker_MarketValue">
            <fixedParams>
                <filter>
                    <thingDefs>
                        <li>Silver</li>
                        <li>MedicineHerbal</li>
                        <li>Beer</li>
                        <li>SmokeleafJoint</li>
                        <li>Yayo</li>
                        <li>Flake</li>
                        <li>WakeUp</li>
                        <li>Pemmican</li>
                    </thingDefs>
                </filter>
            </fixedParams>
        </root>
    </ThingSetMakerDef>

</Defs>