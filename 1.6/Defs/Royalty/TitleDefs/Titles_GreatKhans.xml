<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Great Khans Titles __________-->

    <!-- Prospect -->

    <RoyalTitleDef ParentName="FCP_Base_Empire_Titles">
        <defName>FCP_Title_GreatKhans_Prospect</defName>
        <label>prospect</label>
        <description>New blood, taken in but not yet trusted. A prospect earns their place through the work no one else wants.</description>
        <tags>
            <li>FCP_Title_GreatKhans</li>
        </tags>
        <seniority>0</seniority>
        <favorCost>1</favorCost>
        <changeHeirQuestPoints>1000</changeHeirQuestPoints>
        <allowDignifiedMeditationFocus>False</allowDignifiedMeditationFocus>
        <awardWorkerClass>RoyalTitleAwardWorker_Instant</awardWorkerClass>
        <permitPointsAwarded>1</permitPointsAwarded>
    </RoyalTitleDef>

    <!-- Rider -->

    <RoyalTitleDef ParentName="FCP_Base_Empire_Titles">
        <defName>FCP_Title_GreatKhans_Rider</defName>
        <label>rider</label>
